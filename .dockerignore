# Archivos que no entran al contexto de construcción de la imagen.
# Referencia: https://docs.docker.com/build/concepts/context/#dockerignore-files

# Git
/.git/
/.gitignore

# Configuración local de Bundler
/.bundle

# Variables de entorno y llaves: nunca dentro de la imagen
/.env*
/config/master.key
/config/credentials/*.key

# Logs y temporales (se conservan los directorios)
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# Assets generados
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# CI, despliegue y documentación no se necesitan para ejecutar la app
/.github
/config/deploy*.yml
/.kamal
/.devcontainer
/docs

# Archivos de Docker
/.dockerignore
/Dockerfile*
