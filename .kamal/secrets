# Secretos que config/deploy.yml puede referenciar en registry/password, env/secret y
# accessories/*/env/secret. Este archivo se versiona: NUNCA escribas aquí una credencial en claro.
# Todo se lee del entorno de quien despliega, de un gestor de contraseñas o de un archivo local.
#
# Ejemplo con un gestor de contraseñas compatible (1Password, Bitwarden, LastPass...):
#   SECRETS=$(kamal secrets fetch --adapter 1password --account mi-cuenta --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
#   KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})

# config/master.key nunca se sube a git (está en .gitignore).
RAILS_MASTER_KEY=$(cat config/master.key)

# Se leen del entorno de quien despliega.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
FARO_COBRANZA_DATABASE_PASSWORD=$FARO_COBRANZA_DATABASE_PASSWORD
POSTGRES_PASSWORD=$FARO_COBRANZA_DATABASE_PASSWORD

# Correo saliente (restablecimiento de contraseña). Opcionales: sin SMTP no se envían correos.
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
