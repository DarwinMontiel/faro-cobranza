#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Prepara o actualiza el entorno de desarrollo. Es idempotente: se puede correr cuantas veces
  # se quiera. Opciones: --reset (recrea la base) y --skip-server (no arranca el servidor).

  puts "== Instalando dependencias =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparando la base de datos =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Limpiando logs y temporales =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Iniciando el servidor de desarrollo =="
    STDOUT.flush # vacía la salida antes de exec(2) para que se alcance a ver
    exec "bin/dev"
  end
end
